<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- WebView taking 40% of screen height -->
    <WebView
        android:id="@+id/mediaPlayerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="500dp" />

    <!-- Comments header TextView -->
    <TextView
        android:id="@+id/commentsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/comments"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="5dp"
        app:layout_constraintTop_toBottomOf="@id/mediaPlayerView"
        app:layout_constraintStart_toStartOf="parent" /> <!-- Left alignment -->

    <!-- RecyclerView taking 50% of screen height -->


</androidx.constraintlayout.widget.ConstraintLayout>
