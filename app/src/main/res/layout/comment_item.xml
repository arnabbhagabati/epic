<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@android:color/transparent">

    <!-- Profile Icon with 4dp padding on top -->
    <ImageView
        android:id="@+id/commentProfileIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:src="@drawable/person_24dp"
        android:contentDescription="@string/commenter_icon"
        android:scaleType="centerCrop"
        android:background="@drawable/circular_background"
        android:backgroundTint="@color/white"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp" />

    <!-- Name and Comment Text -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">

        <!-- Commenter's Name (Split into Two TextViews) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commenterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commenter Name"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/commentTimeElapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 2 years ago"
                android:textColor="@android:color/darker_gray"
                android:textStyle="normal"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Comment Text -->
        <TextView
            android:id="@+id/commentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/long_comment"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:id="@+id/replies_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp" />
    </LinearLayout>
</LinearLayout>